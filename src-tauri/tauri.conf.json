{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-config-schema/schema.json",
  "productName": "EuoraCraft Launcher",
  "version": "0.1.0",
  "identifier": "com.eclteam.euoracraft-launcher",
  "build": {
    "frontendDist": "../EuoraCraft-UI/dist",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm --prefix ../EuoraCraft-UI build"
  },
  "app": {
    "windows": [
      {
        "title": "EuoraCraft Launcher",
        "width": 1000,
        "height": 700,
        "minWidth": 800,
        "minHeight": 600,
        "center": true,
        "decorations": false,
        "transparent": false,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico"
      },
      "wix": null
    }
  }
}
